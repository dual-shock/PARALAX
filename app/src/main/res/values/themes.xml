<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Paralax.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/cream</item>
        <item name="postSplashScreenTheme">@style/Theme.Paralax</item>
    </style>

    <style name="Theme.Paralax" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
    </style>
</resources>
